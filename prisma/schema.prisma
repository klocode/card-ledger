// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum CardStatus {
  OWNED
  WATCHING
}

model Card {
  id           String         @id @default(cuid())
  name         String
  game         String
  printing     String?
  finish       String?
  type         String?
  status       CardStatus     @default(WATCHING)
  qty          Int?
  targetPrice  Float?
  group        String?
  tags         Tag[]
  priceEntries PriceEntry[]
  purchases    Purchase[]
  runMoves     PriceRunMove[]
  pulls        Pull[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([name])
  @@index([game])
  @@index([status])
}

model Tag {
  id    String @id @default(cuid())
  name  String @unique
  cards Card[]
}

model PriceEntry {
  id        String   @id @default(cuid())
  cardId    String
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  price     Float
  date      DateTime
  source    String
  createdAt DateTime @default(now())

  @@index([cardId, date])
}

/// A single acquisition of a card: one buy, at one price, on one day.
///
/// Lots rather than a `costBasis` column on Card, because a playset is
/// usually assembled over time at different prices — one column would force
/// either an overwrite or a hand-kept average. Keeping each buy means the
/// weighted-average basis is derived, and `Card.qty` can be recomputed from
/// the lots instead of being maintained by hand.
///
/// Distinct from PriceEntry: a PriceEntry is what the *market* said on a day,
/// a Purchase is what *you* actually paid. Only the former feeds the chart
/// line; the latter is plotted on top of it as a marker.
model Purchase {
  id        String   @id @default(cuid())
  cardId    String
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  qty       Int
  /// Per-copy price paid, before fees.
  unitPrice Float
  date      DateTime
  /// Where it came from — TCGplayer, an LGS name, a trade. Free text.
  source    String?
  /// Shipping/tax for the lot as a whole, not per copy.
  fees      Float?
  notes     String?
  createdAt DateTime @default(now())

  @@index([cardId, date])
}

/// One "fetch all prices" run, kept as a dated report rather than a raw log.
///
/// Prices are one-per-card-per-day (a re-fetch replaces the day's entry), so a
/// second run on the same day is a correction of the first, not a new event —
/// hence the unique `date` and the replace-on-record behaviour. `ranAt` keeps
/// the wall-clock time of whichever run last stood.
///
/// The counts are of the whole run; `moves` holds only the moves worth reading
/// (see `isNotableMove`), because a report that lists every half-cent drift is
/// one nobody opens.
model PriceRun {
  id               String         @id @default(cuid())
  /// Midnight-anchored day the run priced, matching PriceEntry.date.
  date             DateTime       @unique
  ranAt            DateTime       @default(now())
  /// Cards attempted.
  checked          Int
  /// Prices successfully written.
  logged           Int
  /// Cards Scryfall could not price.
  skipped          Int
  /// Priced cards with no earlier entry to compare against.
  firstTime        Int            @default(0)
  risers           Int            @default(0)
  fallers          Int            @default(0)
  /// Net change in the value of OWNED cards (delta × qty), for the day.
  ownedValueChange Float          @default(0)
  /// `[{ name, reason }]` — SQLite has no array column, and these are only
  /// ever read back whole, so they ride along as JSON.
  skippedDetail    Json?
  moves            PriceRunMove[]

  @@index([date])
}

/// A single notable price move inside a run.
///
/// The card link is optional and severed rather than cascaded on delete: a
/// report is a record of what happened that day, and deleting a card should
/// not rewrite history. The name is denormalised for the same reason.
model PriceRunMove {
  id       String   @id @default(cuid())
  runId    String
  run      PriceRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  cardId   String?
  card     Card?    @relation(fields: [cardId], references: [id], onDelete: SetNull)
  name     String
  printing String?
  finish   String?
  price    Float
  previous Float
  delta    Float
  /// Fractional change (0.12 = +12%).
  pct      Float

  @@index([runId])
}

/// A kind of sealed product — "Marvel Collector Booster", a Pokémon booster
/// box. The thing that gets bought repeatedly.
///
/// A row of its own rather than a name on the purchase, because the question
/// this answers is per-product: two Marvel box buys six months apart are the
/// same product and have to roll up together. Grouping on a typed string
/// would work until "Collector Booster" met "collector booster" and quietly
/// became two products with two P&Ls — hence the unique constraint, which
/// makes the rollup a fact instead of a hope.
model SealedProduct {
  id        String           @id @default(cuid())
  name      String
  /// Free text, matching Card.game, so Pokémon and MTG coexist without an
  /// enum to keep updated.
  game      String
  setCode   String?
  setName   String?
  purchases SealedPurchase[]
  createdAt DateTime         @default(now())

  @@unique([game, name])
  @@index([game])
}

/// A buy of sealed product: N packs of one product, at one price, on one day.
///
/// Mirrors Purchase deliberately — a box is a lot, the same way a playset is,
/// and for the same reason: boxes bought on sale and at retail have genuinely
/// different per-pack costs, and one averaged column would erase that.
model SealedPurchase {
  id        String        @id @default(cuid())
  productId String
  product   SealedProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Packs bought; 1 for a single pack.
  packCount Int
  /// Per-pack price, before fees.
  unitPrice Float
  /// Shipping/tax for the lot as a whole, not per pack.
  fees      Float?
  date      DateTime
  source    String?
  notes     String?
  openings  PackOpening[]
  createdAt DateTime      @default(now())

  @@index([productId])
}

/// One pack opened, on one day.
///
/// Its cost is derived from the parent purchase rather than stored, so
/// correcting a box price corrects every pack in it instead of leaving stale
/// copies behind.
model PackOpening {
  id         String         @id @default(cuid())
  purchaseId String
  purchase   SealedPurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  date       DateTime
  notes      String?
  pulls      Pull[]
  createdAt  DateTime       @default(now())

  @@index([purchaseId])
}

/// One card out of one pack.
///
/// The card link is optional and severed rather than cascaded, and the name
/// is denormalised — same reasoning as PriceRunMove: an opening records what
/// came out of that pack, and deleting a card should not rewrite it.
///
/// `valueAtOpen` is a snapshot because it cannot be re-derived later. The
/// card's price moves, and "was this worth cracking" is a question about the
/// day it was cracked; what the pulls are worth *now* comes from the linked
/// card's latest PriceEntry instead.
model Pull {
  id          String      @id @default(cuid())
  openingId   String
  opening     PackOpening @relation(fields: [openingId], references: [id], onDelete: Cascade)
  cardId      String?
  card        Card?       @relation(fields: [cardId], references: [id], onDelete: SetNull)
  name        String
  printing    String?
  finish      String?
  qty         Int         @default(1)
  /// Per-copy market price on the day it was pulled, when one was known.
  valueAtOpen Float?
  createdAt   DateTime    @default(now())

  @@index([openingId])
}
